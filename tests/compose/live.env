# Points the live tests at tests/compose/stack.yml. `make test-live` loads it; by hand:
#   set -a; . tests/compose/live.env; set +a; uv run pytest -q
# Test fixtures for throwaway containers, not credentials.

# Lakekeeper, for tests/test_attach.py and the attach-mode fixtures
ICELENS_TEST_CATALOG_URI=http://127.0.0.1:18282/catalog
ICELENS_TEST_S3_ENDPOINT=http://127.0.0.1:19000
ICELENS_TEST_S3_BUCKET=keeper
ICELENS_TEST_S3_REGION=us-east-1
ICELENS_TEST_S3_ACCESS_KEY=rustfsadmin
ICELENS_TEST_S3_SECRET_KEY=rustfsadmin

# Polaris, for tests/test_polaris.py (the bootstrap credential root:s3cr3t is its default)
ICELENS_TEST_POLARIS_URI=http://127.0.0.1:18181/api/catalog
ICELENS_TEST_POLARIS_S3_ENDPOINT=http://127.0.0.1:19000
ICELENS_TEST_POLARIS_S3_BUCKET=polaris
ICELENS_TEST_POLARIS_S3_ACCESS_KEY=rustfsadmin
ICELENS_TEST_POLARIS_S3_SECRET_KEY=rustfsadmin
